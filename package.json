{
  "name": "nogamenolife",
  "productName": "nogamenolife",
  "version": "0.0.1",
  "description": "personal management tool",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "build": "node -e \"require('fs').rmSync('.vite', { recursive: true, force: true })\" && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "prepack": "corepack yarn build",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "ts-node tests/layout.test.ts",
    "typecheck": "tsc --noEmit",
    "bundle:all": "file_bundle -v -s"
  },
  "keywords": [],
  "author": {
    "name": "bagaking",
    "email": "zfaustk@qq.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bagaking/nogamenolife.git"
  },
  "homepage": "https://github.com/bagaking/nogamenolife#readme",
  "bugs": {
    "url": "https://github.com/bagaking/nogamenolife/issues"
  },
  "files": [
    ".vite/build",
    ".vite/renderer",
    "forge.config.ts",
    "index.html",
    "src",
    "tests",
    "tsconfig.json",
    "vite.main.config.ts",
    "vite.preload.config.ts",
    "vite.renderer.config.ts"
  ],
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.2.0",
    "@electron-forge/plugin-vite": "^7.2.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react-refresh": "^1.3.6",
    "electron": "^28.1.0",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "less": "^4.2.0",
    "less-loader": "^11.1.3",
    "ts-node": "^10.0.0",
    "typescript": "~5.3.3"
  },
  "dependencies": {
    "antd": "^5.12.5",
    "date-fns": "^3.0.6",
    "dayjs": "^1.11.10",
    "electron-squirrel-startup": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-electron-webview": "^2.0.2"
  }
}
